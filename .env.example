# Database connection string (Supabase PostgreSQL with psycopg)
DATABASE_URL=postgresql+psycopg://postgres.vrgcgtgoxevlziyqzxjl:YOUR_PASSWORD@aws-1-eu-west-1.pooler.supabase.com:5432/postgres

# Alternatively, configure connection parameters individually:
# DB_HOST=aws-1-eu-west-1.pooler.supabase.com
# DB_PORT=5432
# DB_NAME=postgres
# DB_USER=postgres.vrgcgtgoxevlziyqzxjl
# DB_PASSWORD=YOUR_PASSWORD

# Connection Pool Settings
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=10

# Security & Authentication
JWT_SECRET_KEY=GENERATE_A_LONG_RANDOM_SECRET_WITH_PYTHON_SECRETS
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=30

# CORS (comma-separated origins or * for all)
# BACKEND_CORS_ORIGINS=["*"]

# Optional Demo / Seed Data
DEMO_EMAIL=johndoe@example.com
DEMO_PASSWORD=YOUR_INITIAL_PASSWORD
DEMO_FIRSTNAME=John
DEMO_LASTNAME=Doe